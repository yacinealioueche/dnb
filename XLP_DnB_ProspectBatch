global class XLP_DnB_ProspectBatch
    implements Database.Batchable<SObject>,
               Database.AllowsCallouts {

    global Database.QueryLocator start(
        Database.BatchableContext bc
    ) {

        return Database.getQueryLocator(
            [
                SELECT Id,
                       Name,
                       XLP_DunsNumber__c
                FROM Account
                WHERE XLP_MDM_AccountStatus__c = 'Prospect'
                AND XLP_DunsNumber__c != null
            ]
        );
    }

    global void execute(
        Database.BatchableContext bc,
        List<SObject> scope
    ) {

        List<Account> accounts =
            (List<Account>) scope;

        XLP_DnB_IntegrationService.process(accounts);
    }

    global void finish(
        Database.BatchableContext bc
    ) {
    }
}
